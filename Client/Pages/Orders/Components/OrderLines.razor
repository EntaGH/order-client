@using Client.Pages.Orders.Models
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            Order Lines

            <span class="badge bg-secondary">
                @OrderLineList.Count()
            </span>
        </h5>
    </div>

    <div class="card-body p-0">
        @if (!OrderLineList.Any())
        {
            <div class="p-3">
                No order lines found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>SKU</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                            <th>Created At</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in OrderLineList)
                        {
                            <tr>
                                <td>@line.Id</td>

                                <td>@line.Sku</td>

                                <td>@line.Quantity</td>

                                <td>
                                    @line.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    @((line.Quantity * line.UnitPrice).ToString("N2"))
                                </td>

                                <td>
                                    @line.CreatedAt.ToLocalTime()
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<OrderLine> OrderLineList { get; set; } = [];
}