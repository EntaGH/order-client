@using Client.Pages.Orders.Request;

<EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-danger">
            @_message
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Order Information</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">
                    Customer ID
                </label>

                <InputText
                    class="form-control"
                    @bind-Value="_model.CustomerId" />

                <ValidationMessage
                    For="@(() => _model.CustomerId)" />
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Order Lines</h5>

            <button
                type="button"
                class="btn btn-primary btn-sm"
                @onclick="AddOrderLine">
                Add Line
            </button>
        </div>

        <div class="card-body">
            @if (!_model.OrderLines.Any())
            {
                <div class="text-muted">
                    No order lines.
                </div>
            }
            else
            {
                @foreach (var line in _model.OrderLines)
                {
                    <div class="row mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">
                                SKU
                            </label>

                            <InputText
                                class="form-control"
                                @bind-Value="line.Sku" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">
                                Quantity
                            </label>

                            <InputNumber
                                class="form-control"
                                @bind-Value="line.Quantity" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">
                                Unit Price
                            </label>

                            <InputNumber
                                class="form-control"
                                @bind-Value="line.UnitPrice" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">
                                Total
                            </label>

                            <input
                                class="form-control"
                                value="@((line.Quantity * line.UnitPrice).ToString("N2"))"
                                readonly />
                        </div>

                        <div class="col-md-2">
                            <button
                                type="button"
                                class="btn btn-danger"
                                @onclick="() => RemoveOrderLine(line)">
                                Remove
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="/orders" class="btn btn-secondary">
            Cancel
        </a>

        <button
            type="submit"
            class="btn btn-primary"
            disabled="@IsLoading">

            @if (IsLoading)
            {
                <span>Creating...</span>
            }
            else
            {
                <span>Create Order</span>
            }
        </button>
    </div>
</EditForm>

@code {
    [Parameter]
    public EventCallback<CreateOrderRequest> OnSubmit { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private CreateOrderRequest _model = new();

    private string? _message;

    private void AddOrderLine()
    {
        _model.OrderLines.Add(
            new CreateOrderLineRequest());
    }

    private void RemoveOrderLine(CreateOrderLineRequest line)
    {
        _model.OrderLines.Remove(line);
    }

    private async Task HandleSubmitAsync()
    {
        _message = null;

        if (!_model.OrderLines.Any())
        {
            _message = "At least one order line is required.";

            return;
        }

        await OnSubmit.InvokeAsync(_model);
    }
}