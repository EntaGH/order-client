@page "/stock-items/{Id:guid}/edit"

<PageTitle>Update Stock Item</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Update Stock Item</h3>

        <a
            href="/stock-items"
            class="btn btn-outline-secondary">
            Back
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-danger">
            @_message
        </div>
    }

    @if (_stockItem is not null)
    {
        <div class="card">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">
                        SKU
                    </label>

                    <input
                        class="form-control"
                        value="@_stockItem.Sku"
                        disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Quantity On Hand
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        @bind="_request.QuantityOnHand"
                        disabled="@_isLoading" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Quantity Reserved
                    </label>

                    <input
                        class="form-control"
                        value="@_stockItem.QuantityReserved"
                        disabled />
                </div>

                <button
                    type="button"
                    class="btn btn-primary"
                    @onclick="UpdateAsync"
                    disabled="@_isLoading">

                    @if (_isLoading)
                    {
                        <span
                            class="spinner-border spinner-border-sm me-2">
                        </span>

                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>Update</span>
                    }

                </button>

            </div>
        </div>
    }

</div>